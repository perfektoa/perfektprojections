# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/

# Node / Vite
node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backups and temp
*.bak
*.bak-before-extend
*.bak-*
*.pre-260calib
*.pre-calib
*.broken-*
nul
/ootp/25

# Local caches and calibration archives — regenerable, hundreds of MB
tgs-viz/ingest/.cache/
tgs-viz/backtest/vintages/*/.waa_cache/
tgs-viz/backtest/.lens_cache/
tgs-viz/backtest/.dev_cache/*
# ML models and training tables go to GitHub through Git LFS (2026-10-06): the
# TGS and BLM model sets, their tuned settings and the four DEV training tables.
# Clones skip them by default (.lfsconfig); see the README. Everything else in
# .dev_cache stays local (old tables, files over GitHub's 2 GB LFS limit).
!tgs-viz/backtest/.dev_cache/ml/
tgs-viz/backtest/.dev_cache/ml/*
!tgs-viz/backtest/.dev_cache/ml/models/
tgs-viz/backtest/.dev_cache/ml/models/*
!tgs-viz/backtest/.dev_cache/ml/models/*_settings.json
!tgs-viz/backtest/.dev_cache/ml/models/TGS/
!tgs-viz/backtest/.dev_cache/ml/models/BLM/
# rating-path models (ml/rating_path.py, 2026-10-08): one set for every league
!tgs-viz/backtest/.dev_cache/ml/models/ratings/
!tgs-viz/backtest/.dev_cache/ml/data/
tgs-viz/backtest/.dev_cache/ml/data/*
!tgs-viz/backtest/.dev_cache/ml/data/dev_H_TGS.pkl
!tgs-viz/backtest/.dev_cache/ml/data/dev_P_TGS.pkl
!tgs-viz/backtest/.dev_cache/ml/data/dev_H_BLM.pkl
!tgs-viz/backtest/.dev_cache/ml/data/dev_P_BLM.pkl
!tgs-viz/backtest/.dev_cache/ml/data/schema_TGS.json
!tgs-viz/backtest/.dev_cache/ml/data/schema_BLM.json
!tgs-viz/backtest/.dev_cache/ml/data/parity_TGS.json
!tgs-viz/backtest/.dev_cache/ml/data/parity_BLM.json
tgs-viz/engine/calib/*/*.csv
# park tables are small and checked in (ingest/parks.py reads them)
!tgs-viz/engine/calib/*/park_*.csv
tgs-viz/backtest/ratings_history.db*
*.db-shm
*.db-wal
*.db-journal
tgs-viz/backtest/snapshots/
# DEV research league vintages: ~1.5 GB, rebuilt from the DEV dumps by dump_vintages.py
tgs-viz/backtest/vintages/DEV/

# Old hand copies of league data folders (not loaded by the app)
tgs-viz/public/data/* - Copy/

# Engine intermediate output (rebuilt by refresh.py from the sheets)
tgs-viz/public/data/**/*_engine.json

# One-off analysis artifact, not loaded by the app (~34 MB each)
tgs-viz/public/data/**/*_scurve_preview.json

# Stray files from a mistyped command
/The
/Save

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Unused alternative projection method (not used by webapp/regressions)
/batting/
/pitching/

# OOTP filter exports and shortcuts (not part of regressions/webapp)
/perfekt filters and views/
/OOTP Baseball 26.lnk

# Claude workspace metadata
.claude/

# StatsPlus API tokens (user-edited, never committed)
StatsPlus Tokens.txt

# Control panel: local settings, bad settings copies and job folders (never committed)
settings.local.json
settings.local.bad-*.json
/.control*/
# Vite caches of worktree test servers
/.vite-cache*/
/tgs-viz/.vite-cache*/
*.tmp
# Excel lock files hold the Windows user name
~$*
# winsim diagnostic screenshots
ootp/_diag_*.png
